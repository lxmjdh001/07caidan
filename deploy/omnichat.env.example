# WzzScrm 后端生产环境变量。部署时复制为 /etc/omnichat/omnichat.env 并填好真实值。
# systemd 单元通过 EnvironmentFile 读取本文件。切勿把填好的真文件提交进仓库。

# 只监听回环：外网一律走 Caddy 反代，配合 OMNI_TRUST_PROXY 才安全（XFF 不可伪造）
HOST=127.0.0.1
PORT=8787

# 前置 Caddy 终止 TLS，信任其写入的 X-Forwarded-For，取到真实客户端 IP。
# 因为只绑回环、只有本机 Caddy 能连，这里可放心用 true。（详见 deploy/Caddyfile 注释）
OMNI_TRUST_PROXY=true

# 管理后台生产为同源，一般无需跨域；若另有独立浏览器前端，按逗号列出精确 Origin。
OMNI_CORS_ORIGINS=https://admin.wzzapp.cloud,https://www.wzzapp.cloud

# 对外地址：LINE Webhook 与公开看板 /c/<token> 用它拼绝对链接
OMNI_PUBLIC_URL=https://wzzapp.cloud

# 数据与媒体落盘目录（SQLite、媒体文件、更新包都在这下面）
OMNI_DATA_DIR=/var/lib/omnichat

# 平台登录态、浏览器指纹和代理绑定的云端快照加密密钥。
# 必须固定保存；更换后历史环境将无法解密。生成示例：openssl rand -hex 32
ACCOUNT_ENVIRONMENT_ENCRYPTION_KEY=CHANGE_ME_at_least_32_random_characters

# 管理后台登录（务必改成强密码）
OMNI_ADMIN_USER=admin
OMNI_ADMIN_PASSWORD=CHANGE_ME_strong_password

# 客户端同步令牌（逗号分隔，多客户端可多个）；改成随机长串
OMNI_TOKENS=CHANGE_ME_random_sync_token

# 可选：Claude 意向分析（缺失则走零成本关键词兜底 StubAnalyzer）
# ANTHROPIC_API_KEY=
# OMNI_ANALYSIS_MODEL=claude-opus-5
# OMNI_AUTO_TAG=true

# 可选：注册邮箱验证码 SMTP（不配则验证码打日志，开发模式）
# OMNI_REQUIRE_EMAIL_VERIFY=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# 可选：Crisp 在线客服
# OMNI_CRISP_WEBSITE_ID=

# Meta Messenger / Instagram（服务器只配置一次，客户侧只点网页授权）
# 在 Meta 开发者后台创建 Business 应用，并把 OAuth 回调白名单设为：
# https://wzzapp.cloud/oauth/meta/callback
# Webhooks 回调设为：https://wzzapp.cloud/webhook/meta
# META_APP_ID=
# META_APP_SECRET=
# Instagram API with Instagram Login 会显示一组独立凭证；客户可直接登录专业账号，无需绑定主页
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_webhook_verify_token
# META_LOGIN_CONFIG_ID=
# META_TOKEN_ENCRYPTION_KEY=CHANGE_ME_at_least_32_random_characters
# META_GRAPH_VERSION=v26.0

# TikTok Business Messaging（服务器配置一次，客户侧只在 TikTok 官方网页授权企业号）
# 开发者应用需获批 Business Messaging API，并把回调地址登记为：
# https://wzzapp.cloud/oauth/tiktok/callback
# DIRECT_MESSAGE Webhook 由服务端授权完成时自动登记到：
# https://wzzapp.cloud/webhook/tiktok
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_TOKEN_ENCRYPTION_KEY=CHANGE_ME_at_least_32_random_characters

# X Direct Messages（OAuth 2.0 + PKCE）
# X 开发者后台回调地址：https://wzzapp.cloud/oauth/x/callback
# 需启用 dm.read、dm.write、tweet.read、users.read、offline.access、media.write
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_TOKEN_ENCRYPTION_KEY=CHANGE_ME_at_least_32_random_characters

# Snapchat Public Profile Messaging
# 回调地址：https://wzzapp.cloud/oauth/snapchat/callback
# 仅适用于获准入品牌 Public Profile 与创作者的合作消息，不是普通个人聊天 API
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# SNAPCHAT_TOKEN_ENCRYPTION_KEY=CHANGE_ME_at_least_32_random_characters
