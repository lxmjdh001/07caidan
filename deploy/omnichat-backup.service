[Unit]
Description=WzzScrm SQLite online backup
After=omnichat.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wzzscrm-backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/omnichat /var/backups/omnichat
UMask=0077
