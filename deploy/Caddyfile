# WzzScrm 生产反向代理 —— Caddy 自动申请/续期 Let's Encrypt 证书（HTTPS）。
# 前提：wzzapp.cloud 与 *.wzzapp.cloud 的 A 记录都指向本机公网 IP（已就绪）。
#
# 安全要点：后端只监听 127.0.0.1:8787（见 omnichat.env HOST），外网只能经 Caddy 进来。
# 因此后端开 OMNI_TRUST_PROXY=true 后，X-Forwarded-For 一定由 Caddy 写入、不可被外部伪造，
# 公开看板的地区限制才成立（否则 req.ip=回环，限制形同虚设）。

# API + 公开引流看板（短链接 wzzapp.cloud/c/<token> 直接分享给打粉团队）
wzzapp.cloud {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8787
}

# 官网：独立静态站点（www.wzzapp.cloud）。
www.wzzapp.cloud {
	encode gzip zstd
	root * /var/www/omnichat-site
	file_server
}

# 管理后台：静态 SPA + 同源 API 反代。
# admin 的 API_BASE 生产回落到 window.location.origin（见 admin/src/config.ts 注释「生产用反代」），
# 即它会打 admin.wzzapp.cloud/api/*，所以这里必须把 /api/* 反代到后端，否则后台所有请求 404。
# 同源好处：不依赖 CORS、不涉及跨站 Cookie。公开看板短链在 apex（wzzapp.cloud/c/<token>），此处不放行。
admin.wzzapp.cloud {
	encode gzip zstd
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		root * /var/www/omnichat-admin
		try_files {path} /index.html
		file_server
	}
}
